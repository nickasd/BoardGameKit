@Tutorial(time: 30) {
    @Intro(title: "Basic Structure") {
        In this chapter we're going to create the basic structure needed for the game project to compile. The app will still look very basic and not contain any game logic yet.
        
        @Image(source: "01-07-01-Home.png", alt: "The home menu of the game.")
    }
    
    @Section(title: "SwiftUI App") {
        @ContentAndMedia {
            Create a new SwiftUI project named `CrazyEights`. We only have to change the default `App` class slightly to show the game view.
        }
        
        @Steps {
            @Step {
                Open the default `CrazyEightsApp.swift` file.
                
                @Code(name: "CrazyEightsApp.swift", file: "01-01-01-SwiftUIAppDefault.swift")
            }
            
            @Step {
                Import `BoardGameKit`.
                
                @Code(name: "CrazyEightsApp.swift", file: "01-01-02-SwiftUIAppImport.swift")
            }
            
            @Step {
                Replace the default `ContentView` with BoardGameKit's `GameView`. We'll create `CrazyEightsConfiguration` in a moment. You can delete the `ContentView.swift` file since we won't need it.
                
                @Code(name: "CrazyEightsApp.swift", file: "01-01-03-SwiftUIAppGameView.swift")
            }
        }
    }
    
    @Section(title: "Configuration") {
        @ContentAndMedia {
            BoardGameKit uses a client-server architecture. In its simplest form, the configuration defines which classes BoardGameKit instantiates when a game is started: the game (created by the host) and the game scene (created by each client).
        }
        
        @Steps {
            @Step {
                Create the `CrazyEightsConfiguration.swift` file. Import both `BoardGameKit` and `BoardGameKitHost` and create a new `CrazyEightsConfiguration` class that conforms to the `Configuration` protocol.
                
                @Code(name: "CrazyEightsConfiguration.swift", file: "01-02-01-ConfigurationEmpty.swift")
            }
            
            @Step {
                The first part of the configuration refers to the game host. The only required information is the class of the game that it needs to instantiate. We'll create `CrazyEightsGame` in a moment.
                
                @Code(name: "CrazyEightsConfiguration.swift", file: "01-02-02-ConfigurationHost.swift")
            }
            
            @Step {
                The second part of the configuration refers to the game client. The only required information is the class of the game scene that visualizes the data sent by the host. We'll create `CrazyEightsGameScene` in a moment.
                
                @Code(name: "CrazyEightsConfiguration.swift", file: "01-02-03-ConfigurationClient.swift")
            }
            
            @Step {
                The last part of the configuration are the game credits. We'll just fill in the developer name for now.
                
                @Code(name: "CrazyEightsConfiguration.swift", file: "01-02-04-ConfigurationCredits.swift")
            }
        }
    }
    
    @Section(title: "Game") {
        @ContentAndMedia {
            The class implementing the `Game` protocol contains the game logic. For now we're only going to add the bare minimum for the app to compile.
        }
        
        @Steps {
            @Step {
                Create the `CrazyEightsGame.swift` file. Import `BoardGameKitHost` and create a new `CrazyEightsGame` class that conforms to the `Game` protocol.
                
                @Code(name: "CrazyEightsGame.swift", file: "01-03-01-GameEmpty.swift")
            }
            
            @Step {
                `requiredPlayerCount` defines the minimum and maximum number of players. For our game, it's 2 and 7, respectively.
                
                @Code(name: "CrazyEightsGame.swift", file: "01-03-02-GameRequiredPlayerCount.swift")
            }
            
            @Step {
                Inside `init(savedPlayers:options:)` we initialize the players (we'll create `CrazyEightsPlayer` in a moment). More complex games might initialize other custom data. We ignore the `options` argument since this game has none, but we still need to create the corresponding type.
                
                @Code(name: "CrazyEightsGame.swift", file: "01-03-03-GameInit.swift")
            }
            
            @Step {
                `initialAction()` should return the action that is first sent to the game. This is a so-called *ambient action*, which differs from a *player action* in that it's generated by the game itself. Since `StartGameAction` is the first ambient action, it doesn't contain any data.
                
                @Code(name: "CrazyEightsGame.swift", file: "01-03-04-GameStart.swift")
            }
            
            @Step {
                `handle(action:context)` allows us to handle incoming actions. We'll implement it later.
                
                @Code(name: "CrazyEightsGame.swift", file: "01-03-05-GameHandleAction.swift")
            }
        }
    }
    
    @Section(title: "GamePlayer") {
        @ContentAndMedia {
            On to the `GamePlayer` implementation. While we're not required to implement `GamePlayer` in our player class, doing so will make the interaction with other BoardGameKit functionalities easier later on.
        }
        
        @Steps {
            @Step {
                Create the `CrazyEightsPlayer.swift` file. Import `BoardGameKitHost` and create a new `CrazyEightsPlayer` class that conforms to the `GamePlayer` protocol.
                
                @Code(name: "CrazyEightsPlayer.swift", file: "01-04-01-PlayerEmpty.swift")
            }
            
            @Step {
                `id` uniquely identifies a player.
                
                @Code(name: "CrazyEightsPlayer.swift", file: "01-04-02-PlayerId.swift")
            }
        }
    }
    
    @Section(title: "GameScene") {
        @ContentAndMedia {
            The class implementing the `GameScene3D` protocol creates a visual representation of the game. For now we're only going to add the bare minimum for the app to compile.
        }
        
        @Steps {
            @Step {
                Create the `CrazyEightsGameScene.swift` file. Import `BoardGameKit` and `SceneKit` and create a new `CrazyEightsGameScene` class that inherits from `SCNNode` and conforms to the `GameScene3D` protocol.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-01-GameSceneEmpty.swift")
            }
            
            @Step {
                The `players` array is declared empty, but we'll populate it in a moment (we'll define `CrazyEightsPlayerNode` later).
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-02-GameScenePlayers.swift")
            }
            
            @Step {
                `localPlayer` is set by BoardGameKit at the beginning of a game when the player is the only one on their physical device, or during a game when switching between multiple players sharing the physical device.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-03-GameSceneLocalPlayer.swift")
            }
            
            @Step {
                `focusedPlayer` is set by BoardGameKit at the beginning of a game and whenever focus changes to a different player, either because the local player changed or the player manually changed the perspective to another one. It's usually irrelevant for the gameplay itself. When we'll add player overlays later on, this is used by the default implementation to set the overlay of the focused player at a fixed position at the bottom screen edge.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-04-GameSceneFocusedPlayer.swift")
            }
            
            @Step {
                `actionHandler` is the object that allows the game scene to communicate player actions and other intentions to the framework. It will be set by BoardGameKit after creating the game scene.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-05-GameSceneActionHandler.swift")
            }
            
            @Step {
                `load(savedPlayers:options:)` is the entry point of the game scene. It allows to load assets needed during the game (which we don't have yet). In any case we need to set the `players` array. We also call `positionPlayers(_:mainPosition:otherPositions:hostPlayer:)` to set the player positions: the host player is placed in front of the game, and the other players in an arc behind the game (in this context, "host" refers to the first local player on the device, and not to the device functioning as the host in the client-server architecture). To get access to the host player, we keep a reference to `GameSceneContext.current` during initialization, as a current game scene context is not set during loading.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-06-GameSceneLoad.swift")
            }
            
            @Step {
                `handle(eventGroup:)`, `handle(error:)`, `hidePrivateData(_:for:)` and `enableActions(_:for:)` are called by BoardGameKit at appropriate times. We'll implement these methods later.
                
                @Code(name: "CrazyEightsGameScene.swift", file: "01-05-07-GameSceneHidePrivateData.swift")
            }
        }
    }
    
    @Section(title: "GamePlayerNode") {
        @ContentAndMedia {
            On to the `GamePlayerNode` implementation.
        }
        
        @Steps {
            @Step {
                Create the `CrazyEightsPlayerNode.swift` file. Import `BoardGameKit` and `SceneKit` and create a new `CrazyEightsPlayerNode` class that inherits from `SCNNode` and conforms to the `GamePlayerNode3D` protocol.
                
                @Code(name: "CrazyEightsPlayerNode.swift", file: "01-06-01-PlayerNodeEmpty.swift")
            }
            
            @Step {
                `id` uniquely identifies a player.
                
                @Code(name: "CrazyEightsPlayerNode.swift", file: "01-06-02-PlayerNodeId.swift")
            }
        }
    }
    
    @Section(title: "Compilation succeeded") {
        @ContentAndMedia {
            Now that the app compiles, let's see what happens when we run it.
        }
        
        @Steps {
            @Step {
                You are presented a plain-looking home menu. Click on Play.
                
                @Image(source: "01-07-01-Home.png", alt: "The home menu of the game.")
            }
            
            @Step {
                Click on Local Game.
                
                @Image(source: "01-07-02-Play.png", alt: "The Play menu.")
            }
            
            @Step {
                Click on New Game.
                
                @Image(source: "01-07-03-LocalGame.png", alt: "The Local Game menu.")
            }
            
            @Step {
                Click on the second + button to add a second local player. Since the game requires at least two players and we haven't implemented bots yet, it's the only way to test the game without connecting a second device. Click on Next.
                
                @Image(source: "01-07-04-NewGamePlayers.png", alt: "The players menu.")
            }
            
            @Step {
                For now, the players are assigned randomly generated names.
                
                @Image(source: "01-07-05-NewGameSummary.png", alt: "The game creation summary.")
            }
            
            @Step {
                When you click on Start, an empty game scene is loaded.
            }
        }
    }
    
    @Assessments {
        @MultipleChoice {
            Is the game already playable?
            
            @Choice(isCorrect: false) {
                Yes.
                
                @Justification(reaction: "Try again!") {
                    Please read more carefully next time.
                }
            }
            
            @Choice(isCorrect: true) {
                No.
                
                @Justification(reaction: "That's right!") {
                    Bravo.
                }
            }
        }
    }
}
